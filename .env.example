# ──────────────────────────────────────────────
# SoloSquad Configuration
# `solosquad init` writes this file automatically.
# You can edit it by hand afterwards; re-run `solosquad doctor`
# to verify the changes are picked up.
# ──────────────────────────────────────────────

# 1. Owner info
OWNER_NAME=
OWNER_ROLE=

# 2. Messenger platform (discord / slack) — one per workspace (v1.2.4+).
#    Telegram support was removed in v1.2.4.
MESSENGER=discord

# 3. Discord settings (if MESSENGER=discord)
#    Create at: https://discord.com/developers/applications
#    → New Application → Bot → Reset Token
#    Also enable: Bot → Privileged Gateway Intents → MESSAGE CONTENT
# masked on uninstall — see v0.7 spec (docs/plan/v0.7-uninstall-lifecycle.md §7)
DISCORD_TOKEN=your-discord-bot-token-here

# 4. Slack settings (if MESSENGER=slack)
#    Create at: https://api.slack.com/apps
#    → Create New App → OAuth & Permissions → Bot Token (xoxb-…)
#    → Bot Token scopes: channels:read, channels:manage, chat:write,
#      app_mentions:read, channels:history
#    → Socket Mode → Enable → App-Level Token (xapp-…, scope: connections:write)
#    → Event Subscriptions → Enable → subscribe to message.channels
# masked on uninstall — see v0.7 spec
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_COMMAND_CHANNEL=owner-command

# 5. GitHub Personal Access Token (optional — used for auto repo creation)
#    GitHub Settings → Developer settings → PAT → Fine-grained
#    Permissions: repo (read/write), org (read)
# masked on uninstall — see v0.7 spec
GITHUB_TOKEN=

# 6. Local repos path (where product workspaces are stored)
#    macOS/Linux:  /Users/you/repos   or   ~/repos
#    Windows:      C:/Users/you/Documents/solosquad-repos
REPOS_BASE_PATH=./repos

# 7. Timezone — v1.2.4+: prefer workspace.yaml.timezone over this env var.
#    Kept for backwards compatibility with v0.2.3 and earlier.
TZ=Asia/Seoul

# 8. Docker Compose — Claude Code credentials directory on the host
#    Mounted into the container at /root/.claude so the CLI stays authenticated.
#    Default when unset: ${HOME}/.claude (macOS/Linux).
#    Override if your host stores creds elsewhere.
# CLAUDE_AUTH_DIR=/Users/you/.claude

# 9. LLM API — OpenRouter (optional, dev/test)
#    Create at: https://openrouter.ai → Keys. Free models (IDs ending in :free,
#    or the openrouter/free router) need no credits; free use is limited
#    account-wide (about 20 req/min, 50 req/day under $10 lifetime credits).
#    Read today by prototype/ax-agent-web's dev server (server/llm-proxy.ts) with
#    the same lookup as src/util/config.ts loadEnv (.solosquad/.env → .env), so the
#    core can reuse this key once its API harness lands (redesign open item M13).
# masked on uninstall — see v0.7 spec
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# 10. BizRouter — image AI + reference analysis (optional, prototype content automation)
#     Create at: https://bizrouter.ai → API keys. OpenAI-compatible (Bearer key).
#     Same variable names as ~/Dev/outstanding-pros/cha-z/server/.env.example, so
#     values can be copied across as-is.
#     Rendering is Remotion only — no video-generation model is configured here.
# masked on uninstall — see v0.7 spec
BIZROUTER_API_KEY=
BIZROUTER_BASE_URL=https://bizrouter.ai/api/v1
#     Image assets. IMAGE_PROVIDER: mock (no API call, gradient placeholder)
#     | images (POST /images/generations) | chat (POST /chat/completions with
#     modalities ["image","text"], for image-output / image-edit models)
IMAGE_PROVIDER=images
IMAGE_MODEL=openai/gpt-image-1-mini
IMAGE_SIZE=1024x1536
# gpt-image quality: low | medium | high (empty = model default)
IMAGE_QUALITY=low
IMAGE_TIMEOUT=180
#     Korean narration (optional) — BizRouter TTS
# TTS_MODEL=openai/gpt-4o-mini-tts
# TTS_VOICE=nova
#     rea-video VLM (skills/rea-video, read with `rea-video --env-file .env`).
#     OpenAI-compatible; point it at BizRouter and paste the same key.
#     REA_VLM_MODEL takes a comma list — the next one is tried if one fails.
REA_VLM_BASE_URL=https://bizrouter.ai/api/v1
REA_VLM_API_KEY=
REA_VLM_MODEL=google/gemini-3.1-flash-lite
